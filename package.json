{
  "name": "oracle-studio",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test:auth": "node --import tsx --test tests/auth.test.mjs tests/auth-email.test.mjs",
    "test:ai": "node --import tsx --test tests/ai.test.mjs",
    "test:account-ui": "tsx --tsconfig tsconfig.cloudflare.json --test tests/account-dialogs.test.tsx",
    "test:history": "node --import tsx --test tests/history.test.mjs",
    "test:auth:worker": "npm run build && node --test tests/auth-worker.test.mjs",
    "auth:schema": "node --import tsx scripts/generate-auth-schema.mjs",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ncdai/react-wheel-picker": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "iching-shifa": "^1.8.0",
    "isbot": "^5.2.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "streamdown": "^2.5.0",
    "taibu-core": "^3.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tyme4ts": "^1.5.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "miniflare": "^5.20260811.1-alpha",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
