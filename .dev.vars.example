# 可选域名，不含协议、端口或路径；留空或未设置时使用 openrouter.ai。
OPENROUTER_DOMAIN=
# OpenRouter Management Key，仅由服务端创建和回收账户专属 Key。
OPENROUTER_MANAGEMENT_KEY=
# 创建 Key 的目标 Workspace UUID。
OPENROUTER_WORKSPACE_ID=
# 独立生成的 32 字节随机值，Base64 编码；用于加密数据库内的用户 Key，配置后保持稳定。
AI_KEY_ENCRYPTION_SECRET=
# 对应工作空间中预先创建的 Preset slug；也可在 wrangler.jsonc 的 vars 中调整。
OPENROUTER_BAZI_PRESET=bazi
OPENROUTER_LIUYAO_PRESET=liuyao

# 生成独立的随机密钥（至少 32 字符）；不要在不同环境间复用。
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Resend 的 Sending access API Key；本地填写后会通过 Resend 发送邮件。
RESEND_API_KEY=
# 仅填写邮箱地址，域名必须已在 Resend 验证。
AUTH_EMAIL_FROM=

# Cloudflare 官方测试密钥，自动通过；发布前替换为正式 widget 的密钥。
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
